[Desktop Entry]
Type=Application
Version=1.5
Name=GSExplorer+
GenericName=File Manager
Comment=Dual-pane file manager
Exec=gexplorer %U
TryExec=gexplorer
Icon=gexplorer
Terminal=false
StartupNotify=true
StartupWMClass=gexplorer
Categories=System;FileTools;FileManager;Utility;Qt;
Keywords=files;folders;explorer;commander;dual pane;file manager;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=gexplorer
