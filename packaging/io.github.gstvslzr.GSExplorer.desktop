[Desktop Entry]
Type=Application
Version=1.5
Name=GSExplorer+
GenericName=File Manager
Comment=Dual-pane, keyboard-first file manager
Exec=gsexplorer-plus %U
TryExec=gsexplorer-plus
Icon=io.github.gstvslzr.GSExplorer
Terminal=false
StartupNotify=true
StartupWMClass=gsexplorer-plus
Categories=System;FileTools;FileManager;Qt;
Keywords=files;folders;explorer;commander;dual pane;file manager;sync;backup;duplicates;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=gsexplorer-plus
